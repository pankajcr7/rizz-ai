{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "eval", "../shared"]
}
