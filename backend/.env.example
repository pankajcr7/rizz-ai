# ── AI provider ────────────────────────────────────────────────────────────
# Free & recommended: Groq — get a key (no card) at https://console.groq.com/keys
GROQ_API_KEY=

# Optional free fallback when Groq is rate-limited: Google Gemini
# (https://aistudio.google.com/apikey). Free-tier data may be used for training —
# use test chats only, or enable billing before real users.
GEMINI_API_KEY=
# Default auto: use any other configured provider during an outage or rate limit.
# Set none to disable backups, or name a provider to use only that backup.
AI_FALLBACK=auto

# Optional: force a provider (groq | gemini | openrouter | claude | custom)
# Default: the first of groq → gemini → openrouter → claude that has a key.
AI_PROVIDER=
# Optional: override model ids (free-tier model names change often)
AI_TEXT_MODEL=
AI_VISION_MODEL=
# Provider-specific overrides also apply when that provider is a backup.
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=

# Paid, best quality: Claude
ANTHROPIC_API_KEY=
RIZZ_MODEL=claude-opus-5
RIZZ_EFFORT=low

# OpenRouter free models (~50 requests/day)
OPENROUTER_API_KEY=

# Any other OpenAI-compatible API (AI_PROVIDER=custom)
AI_BASE_URL=
AI_API_KEY=

# Voice practice uses Groq Whisper (free) whenever GROQ_API_KEY is set.
STT_MODEL=whisper-large-v3-turbo

# ── Server ─────────────────────────────────────────────────────────────────
# Random string, 32+ chars: openssl rand -hex 32
TOKEN_SECRET=
PORT=8787
REVENUECAT_WEBHOOK_SECRET=
# Comma-separated browser origins allowed to call the API (default: Expo web on localhost:8081)
CORS_ORIGINS=

# Optional account recovery email. Verify the sender's domain with Resend first.
# Without both values, the reset screen reports that email recovery is unavailable.
RESEND_API_KEY=
RESET_EMAIL_FROM=
# Durable accounts and single-use reset codes in production.
DATABASE_URL=
