{
  "expo": {
    "name": "Rizz AI",
    "slug": "rizz-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rizzai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rizzai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rizz AI uses your photos only when you pick a chat or profile screenshot.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Rizz AI uses the microphone only while you record a voice message in Chat.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "scheme": "rizzai",
    "backgroundColor": "#0E0B14",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d746fe8d-7678-465c-9284-5a7f25fdae13"
      }
    }
  }
}
