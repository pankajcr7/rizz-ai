# Local development only — EAS builds use the "env" blocks in eas.json instead
# (.env files are never uploaded to EAS).
#
# Backend URL. Leave unset to use your local backend (http://localhost:8787 in the
# browser, http://10.0.2.2:8787 in the Android emulator). Use the live server with:
# EXPO_PUBLIC_API_URL=https://rizz-ai-api.onrender.com
EXPO_PUBLIC_API_URL=

# RevenueCat PUBLIC SDK keys (only needed once you set up subscriptions)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Optional: Play Store / landing page link appended to invite messages
EXPO_PUBLIC_INVITE_URL=

# Never put secrets here (Groq key, database URL, TOKEN_SECRET) — everything
# starting with EXPO_PUBLIC_ is bundled into the app and readable by anyone.
